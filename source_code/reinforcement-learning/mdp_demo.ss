;; File: mdp_demo.ss
(import :std/format
        :gerbil/gambit
        "../shared/format")

(export make-3d-vector
        value-iteration
        policy-iteration
        format-decimal
        main)

;; Multi-dimensional vector creation helper
(def (make-3d-vector d1 d2 d3 (val 0.0))
  (let ((v1 (make-vector d1)))
    (do ((i 0 (+ i 1)))
        ((= i d1) v1)
      (let ((v2 (make-vector d2)))
        (do ((j 0 (+ j 1)))
            ((= j d2))
          (vector-set! v2 j (make-vector d3 val)))
        (vector-set! v1 i v2)))))

;; Value Iteration Algorithm
(def (value-iteration nS nA P R (gamma 0.9) (threshold 1e-6))
  (let ((V (make-vector nS 0.0))
        (policy (make-vector nS 0))
        (iterations 0))
    (let loop ()
      (set! iterations (+ iterations 1))
      (let ((delta 0.0))
        (do ((s 0 (+ s 1)))
            ((= s nS))
          (let ((v (vector-ref V s))
                (max-q -1e9))
            (do ((a 0 (+ a 1)))
                ((= a nA))
              (let ((q 0.0))
                (do ((s-prime 0 (+ s-prime 1)))
                    ((= s-prime nS))
                  (let ((prob (vector-ref (vector-ref (vector-ref P s) a) s-prime))
                        (reward (vector-ref (vector-ref R s) a)))
                    (set! q (+ q (* prob (+ reward (* gamma (vector-ref V s-prime))))))))
                (when (> q max-q)
                  (set! max-q q))))
            (vector-set! V s max-q)
            (set! delta (max delta (abs (- v max-q))))))
        (if (< delta threshold)
          (begin
            ;; Extract optimal policy
            (do ((s 0 (+ s 1)))
                ((= s nS))
              (let ((best-a 0)
                    (max-q -1e9))
                (do ((a 0 (+ a 1)))
                    ((= a nA))
                  (let ((q 0.0))
                    (do ((s-prime 0 (+ s-prime 1)))
                        ((= s-prime nS))
                      (let ((prob (vector-ref (vector-ref (vector-ref P s) a) s-prime))
                            (reward (vector-ref (vector-ref R s) a)))
                        (set! q (+ q (* prob (+ reward (* gamma (vector-ref V s-prime))))))))
                    (when (> q max-q)
                      (set! max-q q)
                      (set! best-a a))))
                (vector-set! policy s best-a)))
            `((values . ,V) (policy . ,policy) (iterations . ,iterations)))
          (loop))))))

;; Policy Iteration Algorithm
(def (policy-iteration nS nA P R (gamma 0.9) (threshold 1e-6))
  (let ((V (make-vector nS 0.0))
        (policy (make-vector nS 0))
        (iterations 0))
    (let outer-loop ()
      (set! iterations (+ iterations 1))
      ;; Policy Evaluation
      (let eval-loop ()
        (let ((delta 0.0))
          (do ((s 0 (+ s 1)))
              ((= s nS))
            (let* ((v (vector-ref V s))
                   (a (vector-ref policy s))
                   (new-v 0.0))
              (do ((s-prime 0 (+ s-prime 1)))
                  ((= s-prime nS))
                (let ((prob (vector-ref (vector-ref (vector-ref P s) a) s-prime))
                      (reward (vector-ref (vector-ref R s) a)))
                  (set! new-v (+ new-v (* prob (+ reward (* gamma (vector-ref V s-prime))))))))
              (vector-set! V s new-v)
              (set! delta (max delta (abs (- v new-v))))))
          (when (> delta threshold)
            (eval-loop))))
      
      ;; Policy Improvement
      (let ((policy-stable #t))
        (do ((s 0 (+ s 1)))
            ((= s nS))
          (let ((old-a (vector-ref policy s))
                (best-a 0)
                (max-q -1e9))
            (do ((a 0 (+ a 1)))
                ((= a nA))
              (let ((q 0.0))
                (do ((s-prime 0 (+ s-prime 1)))
                    ((= s-prime nS))
                  (let ((prob (vector-ref (vector-ref (vector-ref P s) a) s-prime))
                        (reward (vector-ref (vector-ref R s) a)))
                    (set! q (+ q (* prob (+ reward (* gamma (vector-ref V s-prime))))))))
                (when (> q max-q)
                  (set! max-q q)
                  (set! best-a a))))
            (vector-set! policy s best-a)
            (unless (= old-a best-a)
              (set! policy-stable #f))))
        (if policy-stable
          `((values . ,V) (policy . ,policy) (iterations . ,iterations))
          (outer-loop))))))

(def (main)
  (let* ((nS 3)
         (nA 2)
         (P (make-3d-vector nS nA nS 0.0))
         (R (make-vector nS)))
    
    (do ((s 0 (+ s 1)))
        ((= s nS))
      (vector-set! R s (make-vector nA 0.0)))
    
    ;; Setup transitions: Action 0 = Stay, Action 1 = Move
    ;; State 0 (Cool)
    (vector-set! (vector-ref (vector-ref P 0) 0) 0 1.0)
    (vector-set! (vector-ref (vector-ref P 0) 1) 0 0.5)
    (vector-set! (vector-ref (vector-ref P 0) 1) 1 0.5)
    
    ;; State 1 (Warm)
    (vector-set! (vector-ref (vector-ref P 1) 0) 0 0.5)
    (vector-set! (vector-ref (vector-ref P 1) 0) 1 0.5)
    (vector-set! (vector-ref (vector-ref P 1) 1) 2 1.0)
    
    ;; State 2 (Overheated)
    (vector-set! (vector-ref (vector-ref P 2) 0) 2 1.0)
    (vector-set! (vector-ref (vector-ref P 2) 1) 2 1.0)
    
    ;; Rewards
    (vector-set! (vector-ref R 0) 0 1.0)
    (vector-set! (vector-ref R 0) 1 2.0)
    (vector-set! (vector-ref R 1) 0 1.0)
    (vector-set! (vector-ref R 1) 1 -10.0)
    (vector-set! (vector-ref R 2) 0 -1.0)
    (vector-set! (vector-ref R 2) 1 -1.0)
    
    (displayln "=== Value Iteration ===")
    (let* ((res-vi (value-iteration nS nA P R))
           (V-vi (cdr (assoc 'values res-vi)))
           (pol-vi (cdr (assoc 'policy res-vi)))
           (iters-vi (cdr (assoc 'iterations res-vi))))
      (displayln (format "Converged in ~a iterations" iters-vi))
      (displayln (format "Values: [~a, ~a, ~a]"
                         (format-decimal (vector-ref V-vi 0) 2)
                         (format-decimal (vector-ref V-vi 1) 2)
                         (format-decimal (vector-ref V-vi 2) 2)))
      (displayln (format "Policy: ~a" pol-vi)))
    
    (displayln "\n=== Policy Iteration ===")
    (let* ((res-pi (policy-iteration nS nA P R))
           (V-pi (cdr (assoc 'values res-pi)))
           (pol-pi (cdr (assoc 'policy res-pi)))
           (iters-pi (cdr (assoc 'iterations res-pi))))
      (displayln (format "Converged in ~a iterations" iters-pi))
      (displayln (format "Values: [~a, ~a, ~a]"
                         (format-decimal (vector-ref V-pi 0) 2)
                         (format-decimal (vector-ref V-pi 1) 2)
                         (format-decimal (vector-ref V-pi 2) 2)))
      (displayln (format "Policy: ~a" pol-pi)))))

(export main)
